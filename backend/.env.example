# ---------- Server ----------
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ---------- Database ----------
# Supabase: Project Settings -> Database -> Connection string (URI, "Transaction" or "Session" pooler also work)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres
# Leave EMPTY to run on an in-memory Postgres for local development.
DATABASE_URL=

# ---------- Auth ----------
# REQUIRED in production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=7d

# ---------- Payments ----------
# mock | paymongo
PAYMENT_PROVIDER=mock
# Mock provider allows the built-in test checkout page + /api/payments/:id/test-success
ALLOW_TEST_PAYMENTS=true

# PayMongo (GCash / Maya / cards) - only needed when PAYMENT_PROVIDER=paymongo
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_SUCCESS_URL=http://localhost:3000/payment/result?status=success
PAYMONGO_CANCEL_URL=http://localhost:3000/payment/result?status=cancelled

# ---------- Network / openNDS ----------
# Shared secret for /api/network/authorize & /deauthorize (called by gateway/controller)
NETWORK_API_KEY=dev-network-key-change-me

# openNDS FAS. fas_secure_enable=0 -> params arrive plaintext. 1+ -> encrypted "fas" + "iv".
OPENNDS_FAS_KEY=
# Where the FAS endpoint sends the client device to log in/subscribe
PORTAL_BASE_URL=http://localhost:3000

# ---------- Admin bootstrap (used by npm run seed) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator
